<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rangeStartBtn"
        style="@style/Widget.AyHalkasi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/period_range_start_pick" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rangeEndBtn"
        style="@style/Widget.AyHalkasi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/period_range_end_pick" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rangeOngoingBtn"
        style="@style/Widget.AyHalkasi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/period_range_ongoing" />

    <TextView
        android:id="@+id/rangeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/period_range_hint"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rangeCancelBtn"
            style="@style/Widget.AyHalkasi.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rangeSaveBtn"
            style="@style/Widget.AyHalkasi.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/period_range_save" />
    </LinearLayout>
</LinearLayout>
